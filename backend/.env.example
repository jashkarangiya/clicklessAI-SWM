MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=clickless_ai
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/clickless_orders
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
APP_SECRET_KEY=changeme
SESSION_ENCRYPTION_KEY=changeme_32_bytes_key_padded_here
PURCHASE_THRESHOLD_AMOUNT=500.00
CONFIRMATION_TTL_SECONDS=900
APP_VERSION=0.1.0

# LLM config (orchestration) — OPENAI_API_KEY is required, the rest are pre-filled
OPENAI_BASE_URL=https://openai.rc.asu.edu/v1
OPENAI_API_KEY=
LLM_MODEL=qwen3-235b-a22b-instruct-2507

# CORS: comma-separated list of allowed frontend origins (never use * with credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# LangGraph checkpointer: "memory" (dev) — swap to "redis" or "postgres" for production
LANGGRAPH_CHECKPOINTER=memory
